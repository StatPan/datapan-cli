{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.datapan.dev/datapan.health-credential-bindings.v1.schema.json",
  "title": "Datapan Health local credential bindings v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bindings"],
  "properties": {
    "schema_version": { "const": "datapan.health-credential-bindings.v1" },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["credential_reference", "credential_scope_key", "provider", "adapter_id", "auth_kind", "credential_group_id", "credential_env_name"],
        "properties": {
          "credential_reference": { "type": "string", "minLength": 1, "maxLength": 1024 },
          "credential_scope_key": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
          "provider": { "type": "string", "minLength": 1, "maxLength": 128 },
          "adapter_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "auth_kind": { "enum": ["service_key", "api_key"] },
          "credential_group_id": { "type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$" },
          "credential_env_name": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,127}$" }
        }
      }
    }
  }
}
